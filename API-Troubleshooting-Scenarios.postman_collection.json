{
  "info": {
    "name": "API Troubleshooting Scenarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },  "item": [
    {
      "name": "404 - Endpoint Not Found",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"API returns 404 Not Found\", function () {\r\n    pm.response.to.have.status(404);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://httpbin.org/status/404",
          "protocol": "https",
          "host": [
            "httpbin",
            "org"
          ],
          "path": [
            "status",
            "404"
          ]
        }
      },
      "response": []
    },
